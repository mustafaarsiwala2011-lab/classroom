rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Student entry requests for gatekeeper review and live updates
    match /entryRequests/{requestId} {
      allow read, write: if true;
    }

    // User accounts and profiles
    match /users/{userId} {
      allow read, write: if true;

      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // Classroom chat messages
    match /chat_messages/{messageId} {
      allow read, create, update: if true;
      // Only the author who typed the message can delete it
      allow delete: if request.auth == null ||
        resource.data.userId == request.auth.uid ||
        resource.data.username == request.auth.token.email ||
        resource.data.username == request.auth.uid;
    }

    // Default fallback
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
